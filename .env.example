# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put real values here.

# ---- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. The public-metrics sync runs on a schedule with no user session,
# so it uses this key and bypasses RLS. Never expose it to the browser.
SUPABASE_SECRET_KEY=
# Only used by the migration CLI (npm run db:push), not by the app at runtime.
SUPABASE_DB_URL=

# ---- Public metrics sync ---------------------------------------------------
# Google Cloud Console -> Credentials -> Create credentials -> API key
# ("Public data", NOT "User data" -- an OAuth client is a different thing).
# Enable "YouTube Data API v3" in the API Library for the same project.
#
# On the key's settings page:
#   Application restrictions -> None. "HTTP referrers" looks like the safe
#     choice but breaks every call: these requests come from a server and
#     carry no referrer, so Google answers 403.
#   API restrictions -> Restrict key -> YouTube Data API v3 only.
#
# This reads PUBLIC statistics for any public channel. No client authorises
# anything. Free tier is 10,000 quota units/day; a sync of a few hundred
# videos every 15 minutes uses a small fraction of that.
YOUTUBE_API_KEY=

# Shared secret guarding GET /api/sync, which Vercel Cron calls on a schedule.
# The route fails closed: if this is unset every request is rejected, rather
# than the endpoint being left open to the internet.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=

# ---- OAuth connectors (all optional) ---------------------------------------
# Only needed for OWNER-ONLY analytics -- impressions, click-through rate,
# retention -- which require each client to authorise the app. The public
# metrics above need none of this.
#
# Redirect URI to register: https://<your-domain>/api/oauth/<provider>/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Instagram and Facebook share one Meta app, and additionally need Meta app
# review before any account other than the developer's own can authorise.
META_CLIENT_ID=
META_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Apify token for the Instagram provider (Settings -> Integrations).
# Metered: each post returned costs credit, capped by the scrape budget.
APIFY_TOKEN=
# Swap in a cheaper actor without a code change, e.g. sones~instagram-posts-scraper-lowcost
APIFY_INSTAGRAM_ACTOR=
