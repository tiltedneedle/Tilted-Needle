# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.playwright-mcp/

# Screenshots taken while verifying UI work. They belong in a scratch dir, not
# in a public repo -- four of them were committed by a `git add -A` before this
# rule existed.
/*.png
/.playwright-mcp/

# Throwaway investigation scripts. These are written into scripts/ rather than
# a temp dir for one reason: node cannot resolve @supabase/supabase-js from
# outside the repo, so a one-off query script has to live next to node_modules.
# They are not deliverables, and twelve of them reached a public repo via a
# `git add -A` while a background audit was still running.
# Any extension, not just .mjs. The pattern was # Any extension, not just .mjs. The pattern covered *.mjs only, and a later
# investigation wrote _tmp-data.json, _tmp-snaps.json and _tmp-clients.json --
# 1.7 MB of scraped workspace data committed to a PUBLIC repo by a git add -A.
scripts/_tmp-*, so the
# JSON these scripts dump alongside themselves was never covered -- and 1.7 MB
# of scraped workspace data reached a PUBLIC repo in commit 6ceac49.
scripts/_tmp-*

# Rendered report PDFs from scripts/report-lab.mjs. Generated on demand.
/report-lab/

# Screenshots and measurements from scripts/ui-lab.mjs. Generated on demand.
/ui-lab/
/ui-lab.json
.youtube-cookies.txt

# Python bytecode from running the transcript service locally
__pycache__/
*.pyc
