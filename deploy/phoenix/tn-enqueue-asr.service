[Unit]
Description=Plan transcript_asr jobs (this is the host with an audio route)
After=network-online.target tn-transcript.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/tn-worker
EnvironmentFile=/etc/tn-worker.env
ExecStart=/opt/node-v22/bin/node --experimental-strip-types --import /opt/tn-worker/scripts/register-alias.mjs /opt/tn-worker/worker/enqueue.mjs --kinds=transcript_asr --backfill
SyslogIdentifier=tn-enqueue-asr
